MONGODB_URL =your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here

CLIENT_URL=http://localhost:3000

EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

CLOUDINARY_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_APIKEY=your_cloudinary_api_key_here
CLOUDINARY_APISECRET=your_cloudinary_api_secret_here

# Rate limits (requests per 15 min window)
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=200

# Admin email for cron failure alerts
ADMIN_EMAIL=your_admin_email@gmail.com

# Google Drive Backup
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Encryption key for .env backup (use any strong passphrase — store this in your password manager)
BACKUP_ENCRYPTION_KEY=your_strong_passphrase_here

# JWT expiry
JWT_EXPIRE=24h